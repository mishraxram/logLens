---
import Base from '../layouts/Base.astro';
---
<Base wide current="cases" title="Cases dashboard · LogLens" description="Investigation dashboard: every evidence item sealed on the LogLens server, its status, investigator and a re-check of the signed, hash-chained ledger.">
  <header class="mb-5">
    <p class="kicker mb-2">PS6 · investigation dashboard</p>
    <h1 class="font-cond font-bold text-2xl sm:text-3xl leading-tight">Cases dashboard</h1>
    <p class="mt-2 max-w-2xl text-ink/80">Every evidence item sealed on the server, who handled it and its latest status. Each row is re-checked now: signature and chain link.</p>
    <p class="mt-2 max-w-2xl text-sm text-muted">Demo ledger: shared by everyone who uses this site, no login. A real deployment would put this page behind an access gate for authorised investigators only.</p>
  </header>

  <section class="panel p-4 mb-6 min-h-[10rem] sm:min-h-[7rem]" aria-live="polite">
    <div class="flex flex-wrap items-center gap-3">
      <!-- min height = 2 lines on a phone, so the longer result text does not push the panel down (layout shift) -->
      <p id="chainState" class="font-semibold px-2 py-1 rounded min-h-[3.5rem] sm:min-h-0">Checking the ledger…</p>
      <button id="reload" type="button" class="btn btn-quiet">Re-check now</button>
      <label class="text-sm flex items-center gap-2 min-h-11 cursor-pointer"><input id="showTests" type="checkbox" class="w-5 h-5 accent-ink" /> Show automated test rows</label>
    </div>
    <p class="text-xs text-muted mt-2">A valid ledger means the receipts were not edited or reordered. It does not by itself prove a file is unchanged: use "Verify integrity" on the Desk with the same file.</p>
    <p id="head" class="font-mono text-xs break-all mt-2"></p>
    <!-- 4 KPI cards: 2 rows on a phone, 1 row from 640 px; room is reserved before they arrive -->
    <dl id="dkpis" class="kpis mt-3 min-h-[10.5rem] sm:min-h-[4.5rem]"></dl>
    <p id="counts" class="text-sm text-muted mt-2 min-h-5">Loading…</p>
  </section>

  <section class="mb-8">
    <div class="panel-h"><h2>Cases</h2><span class="kicker">one per evidence hash</span></div>
    <!-- Evidence ledger: a table on laptops, stacked cards on phones (same rows). Room is reserved before the rows
         arrive and kept afterwards (shrinking it moved the audit trail up: CLS 0.255) -->
    <!-- The reserved room sits on a transparent wrapper, so a short list does not leave a big empty white panel -->
    <div class="min-h-[60vh] lg:min-h-[12rem]">
    <div class="panel ledger-wrap">
      <table class="ledger">
        <thead><tr><th>Evidence</th><th>Status</th><th>Investigator</th><th>Sealed (UTC)</th><th>Actions</th><th>SHA-256</th></tr></thead>
        <tbody id="cases"><tr><td colspan="6" class="text-muted">Loading cases…</td></tr></tbody>
      </table>
    </div>
    </div>
  </section>

  <section>
    <div class="panel-h"><h2>Server audit trail</h2><span class="kicker">newest first · last 200</span></div>
    <div class="panel overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-left text-muted text-xs uppercase tracking-wide bg-ink/5">
          <tr><th class="p-2">#</th><th class="p-2">Server time (UTC)</th><th class="p-2">Investigator</th><th class="p-2">Action</th><th class="p-2">Evidence</th><th class="p-2">Check</th></tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
    <!-- Only the newest rows are drawn at first (every row is still checked above); the rest one click away -->
    <button id="allRows" type="button" class="btn btn-quiet mt-3 hidden"></button>
  </section>
</Base>

<script>
  type Row = { id: number; sealed_at: string; sha256: string; name: string; size: number; investigator: string; action: string; valid: boolean; linkOk: boolean };
  const $ = (id: string) => document.getElementById(id)!;
  // "2026-10-22T18:02:07.228Z" -> "2026-10-22 18:02 UTC"
  const when = (iso: string) => `${iso.slice(0, 10)} ${iso.slice(11, 16)} UTC`;
  function el(tag: string, cls: string, text = '') {
    const n = document.createElement(tag); n.className = cls; n.textContent = text; return n;
  }
  // Status of a case = its newest action (rows arrive newest first)
  // Status = icon + word + colour (never colour alone)
  const STATUS: Record<string, [string, string]> = {
    SEALED: ['● Sealed, not verified yet', 'bg-ink/10'],
    VERIFIED_MATCH: ['✓ Verified: unchanged', 'bg-match text-white'],
    VERIFIED_TAMPERED: ['▲ TAMPERED: hash mismatch seen', 'bg-flag text-white'],
  };
  const FIRST_ROWS = 50;
  let showAll = false;

  async function load() {
    $('chainState').textContent = 'Checking the ledger…';
    let data: { rows: Row[]; intact: boolean } | null = null;
    try {
      const res = await fetch('/api/ledger', { signal: AbortSignal.timeout(6000) });
      if (res.ok) data = await res.json();
    } catch { /* offline: handled below */ }
    const cases = $('cases'), rows = $('rows');
    cases.replaceChildren(); rows.replaceChildren();
    if (!data) {
      $('chainState').textContent = '▲ Server ledger not reachable (offline or not configured). Local evidence checks on the main page still work.';
      $('chainState').className = 'font-semibold text-flag min-h-[3.5rem] sm:min-h-0';
      return;
    }
    const bad = data.rows.filter((r) => !r.valid || !r.linkOk).length;
    $('chainState').textContent = data.intact ? `✓ Ledger intact: all ${data.rows.length} rows signed and chained correctly.` : `▲ LEDGER PROBLEM: ${bad} row(s) failed the signature or chain check.`;
    $('chainState').className = `font-semibold px-2 py-1 rounded min-h-[3.5rem] sm:min-h-0 ${data.intact ? 'bg-match text-white' : 'bg-flag text-white'}`;

    // Ledger head = newest entry hash. Write it down (case notes, screenshot): if newest rows are ever deleted,
    // the head written down earlier will no longer be in the ledger. Row links alone cannot show a cut-off end.
    const top = data.rows[0];
    $('head').textContent = top ? `Ledger head now: #${top.id} · ${top.entry_hash}` : '';

    // Rows from our automated checks (investigator "TEST ..." or the old "check script") are hidden by default.
    // They are still signed, chained and checked above; hiding only affects what is listed.
    const isTest = (r: Row) => /^TEST\b|^check script$/.test(r.investigator);
    const shown = ($('showTests') as HTMLInputElement).checked ? data.rows : data.rows.filter((r) => !isTest(r));
    const hiddenCount = data.rows.length - shown.length;

    // Group rows by evidence hash: first row seen = newest action for that case
    const byHash = new Map<string, Row[]>();
    for (const r of shown) byHash.set(r.sha256, [...(byHash.get(r.sha256) ?? []), r]);
    const tampered = [...byHash.values()].filter((list) => list[0].action === 'VERIFIED_TAMPERED').length;
    // Key numbers at a glance
    const dk = $('dkpis'); dk.replaceChildren();
    const kpi = (label: string, value: number, tone = '') => { const d = el('div', `kpi ${tone}`); d.append(el('dt', '', label), el('dd', '', String(value))); dk.append(d); };
    kpi('Cases', byHash.size);
    kpi('Tampering seen', tampered, tampered ? 'is-bad' : '');
    kpi('Ledger entries checked', data.rows.length);
    kpi('Failed checks', bad, bad ? 'is-bad' : '');
    $('counts').textContent = `${byHash.size} case(s) · ${tampered} with tampering seen · ${data.rows.length} ledger entries checked${hiddenCount ? ` · ${hiddenCount} automated test rows hidden` : ''}`;
    if (!byHash.size) { const tr = el('tr', ''); const td = el('td', 'text-muted', 'No evidence sealed yet. Open a case on the Desk to create the first receipt.'); td.setAttribute('colspan', '6'); tr.append(td); cases.append(tr); }

    for (const [hash, list] of byHash) {
      const latest = list[0], first = list[list.length - 1];
      const [label, cls] = STATUS[latest.action] ?? ['Unknown', 'bg-ink/10'];
      // One ledger row per evidence hash; data-label gives each cell its name when rows stack on a phone
      const tr = el('tr', '');
      const cell = (label: string, node: HTMLElement) => { const td = el('td', ''); td.dataset.label = label; td.append(node); tr.append(td); };
      cell('Evidence', el('span', 'font-semibold break-all', first.name));
      cell('Status', el('span', `inline-block text-xs font-semibold rounded px-2 py-0.5 whitespace-nowrap ${cls}`, label));
      cell('Investigator', el('span', '', [...new Set(list.map((r) => r.investigator))].join(', ')));
      cell('Sealed (UTC)', el('span', 'font-mono text-xs', `${when(first.sealed_at)} · last ${when(latest.sealed_at)}`));
      cell('Actions', el('span', 'font-mono', String(list.length)));
      const h = el('span', 'font-mono text-xs hash-cell', hash); h.title = hash;
      cell('SHA-256', h);
      cases.append(tr);
    }


    const drawn = showAll ? shown : shown.slice(0, FIRST_ROWS);
    const more = $('allRows');
    more.classList.toggle('hidden', shown.length <= FIRST_ROWS);
    more.textContent = showAll ? `Show the newest ${FIRST_ROWS} only` : `Show all ${shown.length} rows`;
    for (const r of drawn) {
      const tr = document.createElement('tr');
      tr.className = 'border-t border-line align-top';
      const ok = r.valid && r.linkOk;
      [String(r.id), r.sealed_at.replace('T', ' ').replace(/\.\d+Z$/, 'Z'), r.investigator, r.action, `${r.name} (${r.size} B)`].forEach((t, i) =>
        tr.append(el('td', `p-2 ${i === 1 || i === 3 ? 'font-mono text-xs' : ''}`, t)));
      tr.append(el('td', `p-2 font-semibold ${ok ? 'text-match' : 'text-flag'}`, ok ? '✓ OK' : `▲ ${!r.valid ? 'bad signature ' : ''}${!r.linkOk ? 'broken link' : ''}`));
      rows.append(tr);
    }
  }

  $('reload').addEventListener('click', load);
  $('showTests').addEventListener('change', load);
  $('allRows').addEventListener('click', () => { showAll = !showAll; load(); });
  load();
</script>
