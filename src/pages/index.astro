---
import Base from '../layouts/Base.astro';

// The 3 "Try sample" cases (files live in public/samples, all made-up sample data)
const samples = [
  { file: '/samples/erp-marks-tamper.csv', label: 'ERP marks tampering', desc: 'DBMS marks changed from 42 to 92 at 2 AM' },
  { file: '/samples/ssh-bruteforce.log', label: 'Server SSH brute force', desc: 'Password guessing, root login, then a backdoor account' },
  { file: '/samples/hinglish-case.csv', label: 'Hinglish case note', desc: 'Investigator note in Hinglish, AI answers in Hindi' },
  // Real data, not made up: 300 lines from the public Loghub research collection (source cited inside the file)
  { file: '/samples/loghub-openssh-real.log', label: 'Real SSH server log', desc: 'Public research data (Loghub), not made up: 300 real lines' },
];
---
<Base wide>
  <!-- Page intro: only before a case is open -->
  <header class="page-head mb-5 flex flex-wrap items-end justify-between gap-x-8 gap-y-2">
    <div>
      <p class="kicker mb-1">ABCS-02 · AI-assisted digital forensics</p>
      <h1 class="font-cond font-bold text-3xl sm:text-4xl leading-tight">Find who changed what.<span class="block text-muted">Prove the log was not touched.</span></h1>
    </div>
    <p class="text-sm text-muted max-w-md">Rules flag events, open-weight AI (Llama 3.1 8B by Meta, Llama licence) explains them, a SHA-256 hash with a signed server receipt seals the evidence.</p>
  </header>

  <!-- Case bar: which evidence is open and its integrity state (filled by showLocker). Sticky under the app bar -->
  <div id="caseStrip" class="strip" data-state="none" role="status">
    <span class="dot" aria-hidden="true"></span>
    <span class="strip-k">Case</span>
    <span id="stripName" class="font-semibold">No case open</span>
    <span id="stripHash" class="hash"></span>
    <!-- Laptop and up: jump to a part of the case -->
    <nav class="secnav" aria-label="Sections of this case">
      <a href="#result">Overview</a><a href="#chainPanel">Chain</a><a href="#aiPanel">AI</a><a href="#changesPanel">Changes</a><a href="#timelinePanel">Timeline</a>
    </nav>
    <span id="stripChip" class="chip ml-auto">Waiting for evidence</span>
    <!-- Once a case is open: bring the intake form back -->
    <button id="stripEdit" type="button" class="strip-edit">Change case</button>
  </div>

  <!-- Workspace: case sidebar (evidence, progress, actions) + investigation area -->
  <div class="ws">
    <aside class="case-aside" aria-label="Case and evidence">
      <!-- Evidence locker: the signature element (an evidence tag carrying the SHA-256) -->
      <section id="locker" class="hidden side-card">
        <div class="side-block">
          <div class="grid gap-2">
            <button id="verify" type="button" class="btn btn-primary w-full">Verify integrity</button>
            <div class="grid grid-cols-2 gap-2">
              <button id="pdf" type="button" class="btn btn-quiet side-btn">PDF report</button>
              <button id="report" type="button" class="btn btn-quiet side-btn">HTML report</button>
            </div>
            <button id="newCase" type="button" class="btn btn-ghost">New case</button>
          </div>
          <input id="verifyFile" type="file" class="sr-only" tabindex="-1" aria-label="Choose the same file again to verify" />
          <div id="verifyOut" class="mt-3" aria-live="polite"></div>
        </div>
        <div class="side-block">
          <p class="side-h">Case progress</p>
          <ol id="progress" class="progress" aria-label="Case progress"></ol>
        </div>
        <div class="side-block">
          <p class="side-h">Evidence <span class="kicker">chain of custody</span></p>
          <div class="evtag">
            <p class="font-semibold">Evidence tag</p>
            <p id="evName" class="text-sm mt-1 whitespace-pre-line"></p>
            <div class="flex items-center gap-1.5 mt-2">
              <p class="text-xs font-semibold">SHA-256</p>
              <details class="tip"><summary aria-label="What is SHA-256?">?</summary><p>A fingerprint of the exact bytes of this evidence. Change one character and the fingerprint changes completely, so a match later means the file is unchanged.</p></details>
              <button id="copyHash" type="button" class="copy-btn">Copy</button>
            </div>
            <p id="evHash" class="font-mono text-xs break-all"></p>
          </div>
          <div id="receipt" class="mt-3 text-sm" aria-live="polite"></div>
        </div>
        <details class="side-block text-sm">
          <summary class="cursor-pointer min-h-11 flex items-center gap-2"><span class="font-semibold">Audit trail</span><span id="chain"></span></summary>
          <p class="text-xs text-muted mt-1">Each entry stores the hash of the one before it, so editing any entry breaks the chain.</p>
          <button id="tamperAudit" type="button" class="text-sm underline text-muted">Tamper test: secretly edit entry 1</button>
          <ol id="auditList" class="font-mono text-xs mt-1 space-y-1 break-all"></ol>
        </details>
      </section>
    </aside>

    <div class="case-main">
      <!-- Intake: the first screen before a case; folds behind "Change case" once one is open -->
      <section id="intake" class="intake">
        <div class="intake-samples">
          <div class="sec-h"><h2>Open a case</h2><span class="kicker">Intake</span></div>
          <p class="text-sm text-muted mb-3">Pick a sample case (three made up for the demo, one real public log) or bring your own log on the right.</p>
          <div class="sample-grid">
            {samples.map((s, i) => (
              <button type="button" data-sample={s.file} class="sample-btn sample-card">
                <span class="sample-n">{String(i + 1).padStart(2, '0')}</span>
                <span class="sample-t">{s.label}</span>
                <span class="sample-d">{s.desc}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="intake-own">
          <label for="investigator" class="field-l">Investigator name</label>
          <input id="investigator" type="text" maxlength="60" autocomplete="name" placeholder="e.g. IT cell, Dr. Sharma"
            class="field mt-1" />
          <p class="text-xs text-muted mt-1 mb-3">Sent with each server receipt: this name, the file name, size and SHA-256 go to a shared demo ledger (no login). The log text does not.</p>
          <label for="log" class="field-l">Log text</label>
          <textarea id="log" rows="7" spellcheck="false"
            class="field mt-1 font-mono text-sm"
            placeholder="Paste ERP audit CSV (time,user,role,ip,action,target,detail), Linux auth.log, an Apache/Nginx access log or an Apache error log. Lines starting with # are case notes."></textarea>
          <div class="flex flex-wrap gap-2 mt-3">
            <button id="run" type="button" class="btn btn-primary">Build timeline</button>
            <label class="btn btn-quiet btn-like">
              Upload a file <input id="file" type="file" class="sr-only" />
            </label>
          </div>
          <p class="text-xs text-muted mt-2">Timelines: ERP audit CSV, Linux auth.log, Apache/Nginx access and Apache error logs. Any other file (PDF, image) is hashed as evidence.</p>
          <p class="text-xs text-muted mt-1">Saved in this browser only (localStorage): a copy of the locked log, its SHA-256 and the audit trail, so the case survives a reload. <strong>New case</strong> clears them.</p>
          <p id="msg" class="text-sm mt-2" aria-live="polite"></p>
        </div>
      </section>

      <section id="result" class="hidden space-y-5">
        <div id="notes"></div>
        <!-- Case summary: verdict, key numbers and a mini MITRE stage strip in one card -->
        <div class="case-sum">
          <div id="verdict" class="verdict"></div>
          <dl id="kpis" class="kpis"></dl>
        </div>
        <p id="stats" class="text-xs text-muted !mt-2"></p>

        <!-- Attack chain: flagged events linked by shared IP / account, in MITRE ATT&CK tactic stages -->
        <div id="chainPanel" class="panel p-4 hidden">
          <div class="panel-h !mb-2 !pb-2"><h2 class="!mr-0">Attack chain</h2><details class="tip"><summary aria-label="What is MITRE ATT&amp;CK?">?</summary><p>MITRE ATT&amp;CK is a public catalogue of attacker tactics (like Credential Access) and techniques (like T1110 password guessing). Each stage here links to its page.</p></details><span class="kicker ml-auto">MITRE ATT&amp;CK · built by rules, not AI</span></div>
          <p class="sr-only">Flagged events joined when they share an IP or an account, then put in MITRE ATT&CK tactic order of first appearance.</p>
          <div id="chains" class="space-y-3"></div>
        </div>

        <!-- AI investigation summary -->
        <div id="aiPanel" class="panel p-4 lg:p-5">
          <div class="panel-h">
            <h2 class="!mr-0">What happened</h2>
            <details class="tip mr-auto"><summary aria-label="What does open-weight AI mean here?">?</summary><p>The model is Llama 3.1 8B by Meta. Its weights are public (Llama licence), so anyone can check or run it. It is small, so the rules cap its verdict and every point must cite real events.</p></details>
            <div class="seg" role="radiogroup" aria-label="Summary language">
              <label><input type="radio" name="lang" value="en" checked /> English</label>
              <label><input type="radio" name="lang" value="hi" /> हिंदी</label>
            </div>
            <button id="ai" type="button" class="btn btn-primary">Analyze with AI</button>
          </div>
          <label class="text-sm flex items-center gap-2 min-h-11 cursor-pointer mt-1"><input id="mask" type="checkbox" checked class="w-5 h-5 accent-ink" /> Mask account names and IPs before sending to the AI</label>
          <p class="text-xs text-muted mt-1">AI: open-weight Llama 3.1 8B (Meta, Llama licence), run on Cloudflare Workers AI; Google Gemini only as a backup if Llama fails. Only the parsed event lines (max 200) are sent, with names and IPs replaced by USER_1 / IP_1 when masking is on (system accounts like root stay readable). Raw files stay in your browser.</p>
          <p id="aiMsg" class="text-sm mt-2" aria-live="polite"></p>
          <div id="aiOut" class="mt-3"></div>
        </div>

        <!-- Change register: who changed what, when, from where, before -> after -->
        <div id="changesPanel" class="panel p-4 lg:p-5">
          <div class="panel-h">
            <h2>Changes made</h2>
            <p id="changeCount" class="text-sm text-muted"></p>
          </div>
          <p class="text-xs text-muted mt-1">Every update, delete or admin form post in the log. "Who" is the account that made it; an account can be stolen, so check the reasons.</p>
          <ol id="changes" class="mt-3 space-y-2"></ol>
        </div>

        <!-- Timeline: every event in time order -->
        <div id="timelinePanel" class="panel p-4 lg:p-5">
          <div class="panel-h">
            <h2>Timeline</h2>
            <!-- Filter chips: one tap shows only what matters -->
            <div class="seg seg-wrap" role="radiogroup" aria-label="Show events">
              <label><input type="radio" name="tlf" value="all" checked /> All <span id="nAll" class="cnt"></span></label>
              <label><input type="radio" name="tlf" value="high" /> ▲ High <span id="nHigh" class="cnt"></span></label>
              <label><input type="radio" name="tlf" value="flagged" /> Flagged <span id="nFlag" class="cnt"></span></label>
              <label><input type="radio" name="tlf" value="changes" /> Changes <span id="nChg" class="cnt"></span></label>
            </div>
          </div>
          <ol id="timeline" class="rail mt-3"></ol>
        </div>
      </section>

      <!-- How it works: under the intake before a case is open -->
      <section id="empty" class="how">
        <picture class="logo-light">
          <source media="(prefers-reduced-motion: reduce)" srcset="/brand/loglens-mark-still.svg" />
          <img src="/brand/loglens-mark.svg" alt="" width="56" height="56" class="how-logo" />
        </picture>
        <picture class="logo-dark">
          <source media="(prefers-reduced-motion: reduce)" srcset="/brand/loglens-mark-dark-still.svg" />
          <img src="/brand/loglens-mark-dark.svg" alt="" width="56" height="56" class="how-logo" />
        </picture>
        <!-- How a case flows, as numbered steps on one rail -->
        <ol class="steps">
          <li><span class="n">01</span><p class="font-semibold">Open the log</p><p class="text-sm text-muted">ERP audit CSV, Linux auth.log, Apache/Nginx access or Apache error log. It is hashed (SHA-256) the moment it opens.</p></li>
          <li><span class="n">02</span><p class="font-semibold">Rules flag events</p><p class="text-sm text-muted">16 explainable rules, each with a reason and a MITRE ATT&amp;CK ID; flagged events are joined into an attack chain.</p></li>
          <li><span class="n">03</span><p class="font-semibold">Open-weight AI explains</p><p class="text-sm text-muted">Llama 3.1 8B writes the story in English or Hindi, cross-checked against the rules. AI down: a labelled rule summary shows.</p></li>
          <li><span class="n">04</span><p class="font-semibold">Seal and verify</p><p class="text-sm text-muted">Signed server receipt, then verify the same file again: MATCH or TAMPERED, with the changed line.</p></li>
        </ol>
      </section>
    </div>
  </div>

  <!-- Short confirmations (report downloaded, hash copied); read out by screen readers -->
  <div id="toasts" class="toasts" role="status" aria-live="polite"></div>

  <!-- Phone only, once a case is open: jump between the parts of the case (44 px targets) -->
  <nav class="casenav" aria-label="Case sections">
    <a href="#result">Story</a>
    <a href="#changesPanel">Changes</a>
    <a href="#timelinePanel">Timeline</a>
    <a href="#locker">Evidence</a>
  </nav>
</Base>

<script>
  import { parseLog } from '../lib/parse.ts';
  import { applyRules, ruleVerdict } from '../lib/rules.ts';
  import { lockEvidence, verifyEvidence, getEvidence, getAudit, audit, clearCase, now, verifyAuditChain, lockFile, tamperAuditForDemo, getOriginal, changedLines, setReceipt } from '../lib/evidence.ts';
  import { buildReport, aiLabel } from '../lib/report.ts';
  import { MITRE, mitreUrl } from '../lib/mitre.ts';
  import { buildChains, STAGES } from '../lib/chain.ts';
  import { crossCheck } from '../lib/crosscheck.ts';
  import { sealOnServer, checkReceipt, getInvestigator, setInvestigator } from '../lib/ledger.ts';
  import { extractChanges, STATUS_TEXT } from '../lib/changes.ts';
  import { makeMasker } from '../lib/redact.ts';

  const $ = (id: string) => document.getElementById(id)!;
  const logBox = $('log') as HTMLTextAreaElement;
  const msg = $('msg');

  // Small helper: create an element with classes and safe text (no innerHTML = no XSS)
  function el(tag: string, cls: string, text = '') {
    const n = document.createElement(tag);
    n.className = cls;
    n.textContent = text;
    return n;
  }

  // A new piece of evidence starts a clean view: the previous case's verify result, AI answer and timeline filter
  // must not be shown against the new evidence (a stale "TAMPERED" would misreport its integrity)
  function resetCaseView() {
    lastVerify = null; lastAi = null;
    $('verifyOut').replaceChildren(); $('aiOut').replaceChildren(); $('aiMsg').textContent = '';
    const all = document.querySelector<HTMLInputElement>('input[name=tlf][value=all]'); if (all) all.checked = true;
    setIntake(false);
  }

  // Sample buttons: load the file into the box and run
  document.querySelectorAll<HTMLButtonElement>('.sample-btn').forEach((b) =>
    b.addEventListener('click', async () => {
      let text = '';
      try {
        const res = await fetch(b.dataset.sample!);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        text = await res.text();
      } catch (err) {
        msg.textContent = `Could not load the sample (${(err as Error).message}). Check the connection and try again.`;
        return;
      }
      msg.textContent = '';
      logBox.value = text;
      resetCaseView();
      await lockEvidence(b.dataset.sample!.split('/').pop()!, logBox.value);
      void sealNow('SEALED');
      run(true);
      openedCase();
    }),
  );

  // File upload: text logs go to the timeline; any other file (PDF, image...) is hashed as raw bytes
  const isTextLog = (f: File) => /\.(log|csv|txt)$/i.test(f.name) || f.type.startsWith('text/');
  ($('file') as HTMLInputElement).addEventListener('change', async (ev) => {
    const input = ev.target as HTMLInputElement;
    const f = input.files?.[0];
    input.value = ''; // allow choosing the same file again
    if (!f) return;
    if (!isTextLog(f)) {
      if (f.size > 50_000_000) { msg.textContent = 'File too big (max 50 MB).'; return; }
      msg.textContent = 'Hashing file…';
      resetCaseView();
      await lockFile(f);
      void sealNow('SEALED');
      msg.textContent = `${f.name} locked as evidence (not a text log, so no timeline).`;
      showLocker();
      return;
    }
    if (f.size > 2_000_000) { msg.textContent = 'Log too big (max 2 MB).'; return; }
    logBox.value = await f.text();
    resetCaseView();
    await lockEvidence(f.name, logBox.value, f);
    void sealNow('SEALED');
    run(true);
    openedCase();
  });

  // ---- Evidence locker ----
  let lastAi: AiResult | null = null;
  let lastVerify: { match: boolean; current: string } | null = null;

  // Investigator name: remembered in this browser, sent with every server receipt
  const invBox = $('investigator') as HTMLInputElement;
  invBox.value = getInvestigator();
  invBox.addEventListener('change', () => setInvestigator(invBox.value));

  // Ask the server for a signed, hash-chained receipt. SEALED receipts are kept on the evidence;
  // verify results are only logged on the server (who checked what, when).
  async function sealNow(action: 'SEALED' | 'VERIFIED_MATCH' | 'VERIFIED_TAMPERED', hash?: string) {
    const ev = getEvidence();
    if (!ev) return;
    const who = getInvestigator() || 'not given';
    const r = await sealOnServer({ sha256: hash ?? ev.hash, name: ev.name, size: ev.size, investigator: who, action });
    if (action === 'SEALED') setReceipt(r);
    await audit(r ? `SERVER_${action}` : 'SERVER_OFFLINE', r ? `receipt #${r.id} · server time ${r.sealed_at} · by ${who}` : 'Server ledger unreachable: local hash only');
    showLocker();
  }

  function showReceipt() {
    const box = $('receipt'); box.replaceChildren();
    const r = getEvidence()?.receipt;
    if (!r) { box.append(el('p', 'text-muted', 'Server receipt: not available (offline or sealing…). The local SHA-256 above still works.')); return; }
    box.append(el('p', 'font-semibold', `Server receipt #${r.id}`),
      el('p', 'text-xs text-muted', `Sealed ${r.sealed_at} (server time, UTC) by ${r.investigator}`),
      el('p', 'font-mono text-xs break-all', `Signature ${r.sig.slice(0, 24)}…`));
    const btn = el('button', 'text-sm underline mt-1 min-h-11', 'Check server receipt') as HTMLButtonElement;
    btn.type = 'button';
    btn.addEventListener('click', async () => {
      const c = await checkReceipt(r.id);
      const same = c?.receipt.sha256 === getEvidence()?.hash;
      const good = !!c && c.valid && c.linkOk && same;
      out.replaceChildren(el('p', `p-2 rounded font-semibold ${good ? 'bg-match text-white' : 'bg-flag text-white'}`,
        !c ? 'Server unreachable: receipt not checked.' : good ? 'RECEIPT VALID: signed by the LogLens server, chain link intact, same hash as the evidence tag.'
          : `RECEIPT PROBLEM: ${!c.valid ? 'signature does not match. ' : ''}${!c.linkOk ? 'chain link broken. ' : ''}${!same ? 'hash differs from the evidence tag.' : ''}`));
      await audit('RECEIPT_CHECK', `receipt #${r.id}: ${good ? 'valid' : 'problem'}`);
    });
    const out = el('div', 'mt-1');
    box.append(btn, out);
  }

  // Case progress (PS6): each step is done when its action is in the audit trail
  const STEPS: [string, RegExp][] = [
    ['Intake', /^EVIDENCE_LOCKED$/], ['Server seal', /^SERVER_SEALED$/], ['Timeline', /^TIMELINE_BUILT$/],
    ['AI summary', /^(AI|OFFLINE)_SUMMARY$/], ['Verified', /^VERIFY_/], ['Report', /^(REPORT_DOWNLOADED|PDF_REPORT)$/],
  ];
  function showProgress() {
    // Only this case: steps after the most recent evidence lock (the trail keeps older cases too)
    const trail = getAudit();
    let start = 0;
    trail.forEach((a, i) => { if (a.action === 'EVIDENCE_LOCKED') start = i; });
    const done = new Set(trail.slice(start).map((a) => a.action));
    const ol = $('progress'); ol.replaceChildren();
    let count = 0;
    // The verify step shows the RESULT of the latest check: a failed check must never look like a green tick
    const lastVerify = trail.slice(start).filter((a) => /^VERIFY_/.test(a.action)).pop()?.action;
    for (const [name, re] of STEPS) {
      const ok = [...done].some((a) => re.test(a));
      if (ok) count++;
      if (name === 'Verified' && lastVerify === 'VERIFY_TAMPERED') ol.append(el('li', 'is-bad', '▲ Tampered'));
      else ol.append(el('li', ok ? 'is-done' : '', `${ok ? '✓ ' : ''}${name}`));
    }
    ol.setAttribute('aria-label', `Case progress: ${count} of ${STEPS.length} steps done`);
  }

  // Case strip: dot colour + chip say sealed / verified / tampered at a glance
  function updateStrip() {
    const ev = getEvidence();
    const strip = $('caseStrip');
    if (!ev) {
      strip.dataset.state = 'none'; $('stripName').textContent = 'No case open'; $('stripHash').textContent = ''; $('stripChip').textContent = 'Waiting for evidence';
      return;
    }
    const state = lastVerify ? (lastVerify.match ? 'match' : 'tampered') : 'sealed';
    strip.dataset.state = state;
    $('stripName').textContent = ev.name;
    $('stripHash').textContent = `SHA-256 ${ev.hash.slice(0, 12)}…${ev.hash.slice(-6)}`;
    $('stripChip').textContent = state === 'match' ? 'Verified: unchanged' : state === 'tampered' ? 'TAMPERED' : ev.receipt ? `Sealed · receipt #${ev.receipt.id}` : 'Locked on this device';
  }

  async function showLocker() {
    const ev = getEvidence();
    $('locker').classList.toggle('hidden', !ev);
    updateStrip();
    if (!ev) return;
    $('evName').textContent = `${ev.name} (${ev.size} bytes)${ev.type ? `\nType ${ev.type} · file last modified ${ev.lastModified}` : ''}\nLocked ${ev.lockedAt} (this device)`;
    $('evHash').textContent = ev.hash;
    showReceipt();
    showProgress();
    const list = $('auditList'); list.replaceChildren();
    getAudit().forEach((a, i) => list.append(el('li', '', `${i + 1}. ${a.at}  ${a.action}  ${a.detail}  [${a.hash.slice(0, 10)}…]`)));
    const broken = await verifyAuditChain();
    const chain = $('chain');
    chain.textContent = broken ? `CHAIN BROKEN at entry ${broken}` : `chain OK (${getAudit().length} entries)`;
    chain.className = broken ? 'text-sm font-semibold text-white bg-flag rounded px-2 py-0.5' : 'text-sm font-semibold text-match';
    if (broken) ($('chain').parentElement!.parentElement as HTMLDetailsElement).open = true;
  }

  // Text evidence: compare with the box. File evidence: ask for the file again and compare its bytes.
  $('verify').addEventListener('click', () => {
    if (getEvidence()?.kind === 'file') ($('verifyFile') as HTMLInputElement).click();
    else verifyEvidence(logBox.value).then(showVerify);
  });
  ($('verifyFile') as HTMLInputElement).addEventListener('change', async (ev) => {
    const input = ev.target as HTMLInputElement;
    const f = input.files?.[0];
    input.value = '';
    if (f) showVerify(await verifyEvidence(await f.arrayBuffer()));
  });

  function showVerify(r: Awaited<ReturnType<typeof verifyEvidence>>) {
    if (!r) return;
    lastVerify = r;
    void sealNow(r.match ? 'VERIFIED_MATCH' : 'VERIFIED_TAMPERED', r.current); // server log of who verified what
    const out = $('verifyOut'); out.replaceChildren();
    if (r.match) {
      out.append(el('p', 'p-3 rounded-lg bg-match text-white font-semibold', 'MATCH: evidence unchanged since it was locked.'));
    } else {
      out.append(el('p', 'p-3 rounded-lg bg-flag text-white font-semibold', 'TAMPERED: hash mismatch. The evidence changed after it was locked.'));
      out.append(el('p', 'font-mono text-xs break-all mt-2', `Locked  ${r.original}`), el('p', 'font-mono text-xs break-all text-flag', `Now     ${r.current}`));
      // Retrieve: compare with the sealed copy saved at lock time, and offer to restore it
      const original = getEvidence()?.kind === 'text' ? getOriginal() : null;
      if (original !== null) {
        const diff = changedLines(original, logBox.value);
        out.append(el('p', 'font-semibold mt-3', `${diff.length} line${diff.length === 1 ? '' : 's'} changed after locking`));
        diff.slice(0, 8).forEach((d) => {
          const box = el('div', 'mt-2 rounded-lg border border-line p-2 text-xs font-mono break-all');
          box.append(el('p', 'text-muted', `Line ${d.line}`), el('p', '', `Before  ${d.before}`), el('p', 'text-flag font-semibold', `After   ${d.after}`));
          out.append(box);
        });
        const restore = el('button', 'btn btn-primary mt-3', 'Restore original');
        restore.addEventListener('click', async () => {
          logBox.value = original;
          await audit('RESTORED', `Original text restored from the sealed copy (${diff.length} lines put back)`);
          await run();
          showVerify(await verifyEvidence(logBox.value));
        });
        out.append(restore);
      }
    }
    showLocker();
  }

  // PDF: open the report in a new tab and open the print dialog ("Save as PDF")
  $('pdf').addEventListener('click', async () => {
    const w = window.open('', '_blank');
    // Shown as a toast: the intake message line is hidden while a case is open
    if (!w) { toast('Pop-up blocked: allow pop-ups to save the PDF, or use HTML report.', 'bad'); return; }
    await audit('PDF_REPORT', 'Report opened for Save as PDF');
    toast('Report opened in a new tab: choose “Save as PDF” in the print dialog');
    w.document.write(buildReport({ evidence: getEvidence(), verify: lastVerify, events: last?.events ?? [], notes: last?.notes ?? [], ai: lastAi, audit: getAudit(), chainBrokenAt: await verifyAuditChain(), generatedAt: now() }));
    w.document.close();
    w.focus();
    setTimeout(() => w.print(), 400);
    showLocker();
  });

  $('tamperAudit').addEventListener('click', () => { tamperAuditForDemo(); showLocker(); });

  $('report').addEventListener('click', async () => {
    await audit('REPORT_DOWNLOADED', 'HTML report generated');
    const html = buildReport({ evidence: getEvidence(), verify: lastVerify, events: last?.events ?? [], notes: last?.notes ?? [], ai: lastAi, audit: getAudit(), chainBrokenAt: await verifyAuditChain(), generatedAt: now() });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([html], { type: 'text/html' }));
    a.download = `loglens-report-${getEvidence()?.hash.slice(0, 8) ?? 'case'}.html`;
    a.click();
    toast(`Report downloaded: ${a.download}`);
    showLocker();
  });

  // Small confirmation that fades after a few seconds (the text stays readable for screen readers via aria-live)
  function toast(text: string, kind: 'ok' | 'bad' = 'ok') {
    const t = el('p', `toast ${kind === 'bad' ? 'is-bad' : ''}`, text);
    $('toasts').append(t);
    setTimeout(() => t.classList.add('is-out'), 3200);
    setTimeout(() => t.remove(), 3600);
  }

  // Copy the full SHA-256 (the case bar shows it shortened)
  $('copyHash').addEventListener('click', async () => {
    const h = getEvidence()?.hash;
    if (!h) return;
    try { await navigator.clipboard.writeText(h); toast('SHA-256 copied'); }
    catch { toast('Could not copy: select the hash and copy it by hand', 'bad'); }
  });

  // New case clears this browser's copy of the case (evidence tag, local audit trail): ask first.
  // Receipts already on the server stay in the ledger; this does not touch them.
  $('newCase').addEventListener('click', () => {
    if (getEvidence() && !confirm('Start a new case?\n\nThis clears the current evidence and its local audit trail in this browser. Receipts already sealed on the server stay in the ledger.')) return;
    clearCase(); resetCaseView(); last = null;
    logBox.value = ''; msg.textContent = '';
    $('result').classList.add('hidden'); showLocker();
    setIntake(true);
    if (location.hash) history.replaceState(null, '', location.pathname + location.search);
  });

  showLocker(); // restore a case saved in this browser

  $('run').addEventListener('click', () => run(true));
  document.querySelectorAll('input[name=tlf]').forEach((r) => r.addEventListener('change', () => run()));
  $('ai').addEventListener('click', analyze);

  // Last parsed result, reused by the AI step
  let last: ReturnType<typeof parseLog> | null = null;

  type AiResult = { source: string; verdict: string; masked?: string; hidden_patterns?: { events: number[]; text: string }[]; model?: string; adjusted?: string; summary: string; indicators: { events: number[]; text: string }[]; confidence: string; next_steps: string[] };

  // Ask the server (Llama on Workers AI first, Gemini as backup). On any failure, fall back to a summary built from the rules.
  async function analyze() {
    if (!last || !last.events.length) { $('aiMsg').textContent = 'Build a timeline first.'; return; }
    const lang = (document.querySelector('input[name=lang]:checked') as HTMLInputElement).value;
    const btn = $('ai') as HTMLButtonElement;
    btn.disabled = true; btn.setAttribute('aria-busy', 'true'); $('aiMsg').textContent = 'Asking AI… (up to 8s)'; $('aiOut').replaceChildren();
    // Send flagged events first so they survive the 200-event limit
    const sorted = [...last.events].sort((a, b) => Number(b.flags.length > 0) - Number(a.flags.length > 0)).slice(0, 200).sort((a, b) => a.n - b.n);
    // Masking (on by default): account names and IPs become USER_1 / IP_1 before sending, and come back here
    const masker = ($('mask') as HTMLInputElement).checked ? makeMasker(last.events) : null;
    const m = (s: string) => (masker ? masker.mask(s) : s);
    const events = sorted.map(({ time, raw, flags, ...e }) => ({ ...e, user: m(e.user), ip: m(e.ip), target: m(e.target), detail: m(e.detail),
      flags: flags.map((f) => `${f.severity.toUpperCase()}: ${m(f.reason)}`) }));
    let result: AiResult;
    try {
      const res = await fetch('/api/analyze', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ events, notes: last.notes.map(m), lang }) });
      const data = await res.json();
      if (!res.ok || !data.summary) throw new Error(data.error || 'AI failed');
      result = data;
      if (masker) {
        const u = masker.unmask;
        result.summary = u(result.summary);
        result.indicators = result.indicators.map((i) => ({ ...i, text: u(i.text) }));
        result.hidden_patterns = result.hidden_patterns?.map((i) => ({ ...i, text: u(i.text) }));
        result.next_steps = result.next_steps.map(u);
        result.masked = `Sent masked: ${masker.users} account name${masker.users === 1 ? '' : 's'} and ${masker.ips} IP${masker.ips === 1 ? '' : 's'} were replaced (USER_1, IP_1...) and put back in your browser.`;
      }
      $('aiMsg').textContent = '';
    } catch (err) {
      result = offlineSummary();
      // Plain words first, the technical reason in brackets for whoever debugs it
      $('aiMsg').textContent = `The AI could not answer, so the rules summary below is shown instead (${(err as Error).message}).`;
    }
    btn.disabled = false; btn.removeAttribute('aria-busy');
    lastAi = result;
    await audit(result.source === 'ai' ? 'AI_SUMMARY' : 'OFFLINE_SUMMARY', `${result.model ?? 'rules'} · confidence ${result.confidence} · ${lang}`);
    showLocker();
    showAi(result);
  }

  // Offline fallback: real findings from the rules, clearly labelled as not AI
  function offlineSummary(): AiResult {
    const flagged = last!.events.filter((e) => e.flags.length);
    // Group by rule: one indicator per rule, citing every event it matched (high-severity rules first)
    const byCode = new Map<string, { text: string; high: boolean; ns: number[] }>();
    flagged.forEach((e) => e.flags.forEach((f) => {
      const g = byCode.get(f.code) ?? { text: f.reason, high: f.severity === 'high', ns: [] };
      g.ns.push(e.n); byCode.set(f.code, g);
    }));
    const groups = [...byCode.values()].sort((a, b) => Number(b.high) - Number(a.high));
    return {
      source: 'offline',
      verdict: flagged.some((e) => e.flags.some((f) => f.severity === 'high')) ? 'suspicious' : 'unsure',
      summary: flagged.length ? `Rules flagged ${flagged.length} of ${last!.events.length} events. Review the indicators below.` : 'Rules found nothing suspicious.',
      indicators: groups.slice(0, 6).map((g) => ({ events: g.ns, text: g.text })),
      confidence: flagged.length >= 3 ? 'medium' : 'low',
      hidden_patterns: [],
      next_steps: ['Retry the AI summary in a minute.', 'Collect server auth logs and database audit logs for the same time window.'],
    };
  }

  function showAi(r: AiResult) {
    const out = $('aiOut'); out.replaceChildren();
    const label = r.source === 'ai'
      ? `${aiLabel(r.model)}. AI generated, can be wrong: check the cited events.`
      : 'Offline summary from rules (AI unavailable). Not AI generated.';
    out.append(el('p', `text-xs mb-3 inline-block px-2 py-1 rounded ${r.source === 'ai' ? 'bg-tag/30' : 'bg-ink/10'}`, label));
    if (r.masked) out.append(el('p', 'text-xs text-muted -mt-2 mb-3', r.masked));
    if (r.confidence === 'low' || r.verdict === 'unsure')
      out.append(el('p', 'mb-3 p-3 rounded-lg bg-tag/25 text-sm', 'Not enough evidence for a clear answer. Next: collect auth logs and database audit logs for the same time window, then run again.'));
    // Verdict chip: status colours only (red incident, amber suspicious, green normal, grey unsure)
    const vc: Record<string, string> = { incident: 'bg-flag text-white', suspicious: 'bg-tag', normal: 'bg-match text-white', unsure: 'bg-ink/10' };
    out.append(el('p', `block w-fit font-cond font-bold text-xl rounded-lg px-3 py-1 mb-3 ${vc[r.verdict] ?? vc.unsure}`, `Verdict: ${r.verdict} (${r.confidence} confidence)`));
    if (r.adjusted) out.append(el('p', 'mb-3 p-2 rounded bg-ink/10 text-sm', r.adjusted));
    out.append(el('p', 'mb-4 text-[17px] leading-relaxed max-w-prose', r.summary));
    const ul = el('ul', 'space-y-2 mb-4');
    r.indicators.forEach((i) => {
      const li = el('li', 'border-l-4 border-flag pl-3');
      li.append(el('span', 'font-mono font-semibold mr-2', i.events.map((n) => `#${n}`).join(' ')), document.createTextNode(i.text));
      ul.append(li);
    });
    out.append(ul);
    // What the AI found that the rules did not say (the "AI-based pattern discovery" part)
    if (r.hidden_patterns?.length) {
      const box = el('div', 'mb-4 p-3 rounded-lg border-2 border-dashed border-tag bg-tag/10');
      box.append(el('p', 'font-semibold mb-1', 'AI found beyond the rules'));
      r.hidden_patterns.forEach((h) => { const p = el('p', 'text-sm mt-1'); p.append(el('span', 'font-mono font-semibold mr-2', h.events.map((n) => `#${n}`).join(' ')), document.createTextNode(h.text)); box.append(p); });
      out.append(box);
    }
    // AI vs rules cross-check (only for a real AI answer; the offline summary IS the rules)
    if (r.source === 'ai' && last) {
      const x = crossCheck(last.events, r); // events already carry the rule flags from run()
      const box = el('div', `mb-4 p-3 rounded-lg border ${x.agree ? 'border-match/50 bg-match/5' : 'border-flag/60 bg-flag/5'}`);
      box.append(el('p', 'font-semibold', 'Cross-check: AI vs rules'), el('p', 'text-sm', x.note));
      const list = (label: string, ns: number[]) => ns.length && box.append(el('p', 'text-sm mt-1', `${label}: ${ns.map((n) => `#${n}`).join(' ')}`));
      list('Rule-flagged events the AI also cited', x.cited);
      list('High-risk events the AI did not mention', x.missed);
      list('Events only the AI pointed to (no rule flag)', x.aiOnly);
      out.append(box);
    }
    out.append(el('p', 'font-semibold', 'Next steps'));
    const steps = el('ol', 'list-decimal pl-5 space-y-1');
    r.next_steps.forEach((s) => steps.append(el('li', '', s)));
    out.append(steps);
  }

  // Phone: "Change case" in the case strip shows the intake form again
  // Case selection <-> open case. The button names where it goes; Esc and the browser Back button also return to the case.
  function setIntake(open: boolean) {
    document.body.classList.toggle('show-intake', open);
    const b = $('stripEdit');
    b.textContent = open ? '← Back to case' : 'Change case';
    b.setAttribute('aria-expanded', String(open));
    if (open) $('intake').scrollIntoView({ block: 'start' });
    // Closed by the button or Esc: drop the "#intake" entry so the next Back is not swallowed by it
    else if (location.hash === '#intake') history.replaceState(null, '', location.pathname + location.search);
  }
  $('stripEdit').addEventListener('click', () => {
    const open = !document.body.classList.contains('show-intake');
    setIntake(open);
    if (open) history.pushState({ intake: true }, '', location.pathname + location.search + '#intake');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    // Esc closes an open term explainer first, else returns from case selection to the case
    const tip = document.querySelector<HTMLDetailsElement>('details.tip[open]');
    if (tip) { tip.open = false; tip.querySelector('summary')?.focus(); return; }
    if (document.body.classList.contains('show-intake') && !$('result').classList.contains('hidden')) setIntake(false);
  });
  // A click outside an open term explainer closes it
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('details.tip[open]').forEach((t) => { if (!t.contains(e.target as Node)) t.open = false; });
  });
  window.addEventListener('popstate', () => {
    // Back from case selection returns to the case (the case itself is kept)
    if (document.body.classList.contains('show-intake') && location.hash !== '#intake') setIntake(false);
  });
  // Opening a case from case selection: drop the "#intake" history entry so Back does not re-open the list
  function openedCase() {
    if (location.hash === '#intake') history.replaceState(null, '', location.pathname + location.search);
  }

  async function run(scrollToResult = false) {
    const text = logBox.value;
    if (!text.trim()) { msg.textContent = 'Paste a log or try a sample.'; $('result').classList.add('hidden'); return; }
    msg.textContent = '';
    if (!getEvidence()) { await lockEvidence('pasted-log.txt', text); void sealNow('SEALED'); } // pasted text becomes evidence on first run
    const parsed = parseLog(text);
    const events = applyRules(parsed.events);
    // New log: the old AI answer and its status line no longer apply
    if (last?.events.map((e) => e.raw).join() !== events.map((e) => e.raw).join()) { $('aiOut').replaceChildren(); $('aiMsg').textContent = ''; }
    last = parsed;
    const v = ruleVerdict(events);

    // Case notes (# lines)
    const notes = $('notes'); notes.replaceChildren();
    parsed.notes.forEach((n) => notes.append(el('p', 'italic text-ink/80 border-l-4 border-tag pl-3 mb-1', n)));

    // Verdict banner: the first thing a judge reads
    const verdict = $('verdict');
    // Status = colour + icon + word, never colour alone
    const ICON: Record<string, string> = { 'is-high': '▲', 'is-med': '●', 'is-ok': '✓', '': '?' };
    const setVerdict = (cls: string, level: string, headline: string) => {
      verdict.className = `verdict ${cls}`;
      const lv = el('p', 'level', level);
      lv.prepend(el('span', 'pill-ico', ICON[cls]));
      lv.firstElementChild!.setAttribute('aria-hidden', 'true');
      verdict.replaceChildren(lv, el('p', 'headline', headline));
    };
    if (events.length === 0) {
      setVerdict('', 'Unsupported input', 'Not a supported log. Use ERP audit CSV, Linux auth.log, an Apache/Nginx access log or an Apache error log, or try a sample.');
    } else if (v.level === 'none') {
      setVerdict('is-ok', 'Rule verdict · low', 'No suspicious pattern found by the rules. Rules can miss things: run the AI summary or check more logs.');
    } else {
      setVerdict(v.level === 'high' ? 'is-high' : 'is-med', `Rule verdict · ${v.level === 'high' ? 'high' : 'medium'} risk`,
        `${v.high} high-risk and ${v.medium} medium-risk events flagged by the rules`);
    }
    // Risk meter: share of events by severity
    if (events.length) {
      const normal = Math.max(0, events.length - v.high - v.medium);
      const bar = el('div', 'meter'); bar.setAttribute('aria-hidden', 'true');
      ([[v.high, '#B42318'], [v.medium, '#E3A72F'], [normal, '#1F7A4D']] as [number, string][]).forEach(([n, c]) => {
        const seg = document.createElement('span'); seg.style.width = `${(n / events.length) * 100}%`; seg.style.background = c; bar.append(seg);
      });
      const legend = el('p', 'meter-legend');
      ([['High', v.high, '#B42318'], ['Medium', v.medium, '#E3A72F'], ['Normal', normal, '#1F7A4D']] as [string, number, string][]).forEach(([l, n, c]) => {
        const t = el('span', '', `${l} ${n}`); const sw = document.createElement('i'); sw.style.background = c; t.prepend(sw); legend.append(t);
      });
      verdict.append(bar, legend);
    }
    $('stats').textContent = `${events.length} events, sorted by time. ${parsed.unparsed.length} lines not understood.`;

    // Attack chain(s)
    const chains = buildChains(events);
    $('chainPanel').classList.toggle('hidden', !chains.length);
    const chainBox = $('chains'); chainBox.replaceChildren();
    for (const c of chains.slice(0, 3)) {
      const box = el('div', '');
      // Actors as chips: account and IP, each with a type label
      const actors = el('p', 'flex flex-wrap items-center gap-1.5 text-sm');
      actors.append(el('span', 'text-muted', 'Actors linked:'));
      c.users.forEach((u) => actors.append(el('span', 'entity', `account ${u}`)));
      c.ips.forEach((i) => actors.append(el('span', 'entity font-mono', `IP ${i}`)));
      box.append(actors);
      const ol = el('ol', 'chain mt-2');
      c.steps.forEach((st, i) => {
        const li = el('li', '');
        const a = el('a', 'mitre-chip !ml-0', st.tactic) as HTMLAnchorElement;
        a.href = `https://attack.mitre.org/tactics/${st.tactic}/`; a.target = '_blank'; a.rel = 'noopener'; a.title = `MITRE ATT&CK tactic ${st.tactic}: ${st.name}`;
        const head = el('span', 'flex flex-wrap items-center gap-x-2 gap-y-1');
        head.append(el('span', 'step-n', String(i + 1)), el('span', 'font-semibold leading-tight', st.name), a);
        const why = el('span', 'text-xs text-ink/75 mt-0.5 clamp-1', st.reasons.join(', '));
        why.title = st.reasons.join(', ');
        li.append(head,
          el('span', 'block font-mono text-xs mt-1', `${st.from.slice(11, 16) || st.from} · ${st.events.map((n) => `#${n}`).join(' ')}`),
          why);
        ol.append(li);
      });
      box.append(ol);
      chainBox.append(box);
    }
    // Mini stage strip in the case summary: all tactic stages in order, the ones this case reached are filled
    if (chains.length) {
      const hit = new Set(chains.flatMap((c) => c.steps.map((s) => s.tactic)));
      const strip = el('div', 'stage-strip');
      strip.append(el('span', 'text-xs font-semibold', 'Attack chain'));
      const dots = el('span', 'dots');
      for (const s of STAGES) {
        const d = el('span', hit.has(s.tactic) ? 'is-hit' : '');
        d.title = `${s.name} (${s.tactic})${hit.has(s.tactic) ? ': reached' : ''}`;
        dots.append(d);
      }
      dots.setAttribute('aria-hidden', 'true');
      strip.append(dots, el('span', 'text-xs text-muted', `${hit.size} of ${STAGES.length} MITRE stages reached`));
      verdict.append(strip);
    }

    // Change register
    const changes = extractChanges(events);
    const bad = changes.filter((c) => c.status === 'unauthorized').length;
    // Key numbers at a glance (all computed above from this log)
    const kpis = $('kpis'); kpis.replaceChildren();
    const kpi = (label: string, value: number, tone = '') => {
      const d = el('div', `kpi ${tone}`); d.append(el('dt', '', label), el('dd', '', String(value))); kpis.append(d);
    };
    kpi('Events', events.length);
    kpi('High-risk events', v.high, v.high ? 'is-bad' : '');
    kpi('Unauthorized changes', bad, bad ? 'is-bad' : '');
    kpi('Attack chain stages', chains[0]?.steps.length ?? 0, chains.length ? 'is-warn' : '');
    $('changeCount').textContent = changes.length ? `${changes.length} change${changes.length === 1 ? '' : 's'}, ${bad} unauthorized` : 'No data changes in this log';
    const chList = $('changes'); chList.replaceChildren();
    const chip: Record<string, string> = { unauthorized: 'bg-flag text-white', suspicious: 'bg-tag', blocked: 'bg-ink/10', normal: 'bg-match text-white' };
    for (const c of changes) {
      const li = el('li', `rounded-lg border p-3 ${c.status === 'unauthorized' ? 'border-flag/50 bg-flag/5' : 'border-line'}`);
      const head = el('div', 'flex flex-wrap items-center gap-2');
      const ico: Record<string, string> = { unauthorized: '▲ ', suspicious: '● ', blocked: '⊘ ', normal: '✓ ' };
      head.append(el('span', `text-xs font-semibold rounded px-2 py-0.5 ${chip[c.status]}`, ico[c.status] + STATUS_TEXT[c.status]),
        el('span', 'font-mono text-sm font-semibold', c.timeText), el('span', 'font-mono text-xs text-muted', `#${c.n}`));
      li.append(head);
      li.append(el('p', 'mt-1', `${c.user}${c.role ? ` (${c.role})` : ''} from ${c.ip || 'unknown IP'}: ${c.action} ${c.target}`));
      if (c.before) li.append(el('p', 'font-mono text-sm mt-1', `Before ${c.before}  →  After ${c.after}`));
      else li.append(el('p', 'font-mono text-sm mt-1', c.after));
      // First 2 reasons in view; the rest fold behind "N more reasons" (still in the page, one click away)
      c.reasons.slice(0, 2).forEach((r) => li.append(el('p', 'text-sm text-ink/80 mt-0.5', r)));
      if (c.reasons.length > 2) {
        const more = el('details', 'more mt-1');
        more.append(el('summary', '', `${c.reasons.length - 2} more reason${c.reasons.length - 2 === 1 ? '' : 's'}`));
        c.reasons.slice(2).forEach((r) => more.append(el('p', 'text-sm text-ink/80 mt-0.5', r)));
        li.append(more);
      }
      chList.append(li);
    }

    // Timeline
    const list = $('timeline'); list.replaceChildren();
    const show = (document.querySelector('input[name=tlf]:checked') as HTMLInputElement | null)?.value ?? 'all';
    const changed = new Set(changes.map((c) => c.n));
    const isHigh = (e: (typeof events)[number]) => e.flags.some((f) => f.severity === 'high');
    $('nAll').textContent = String(events.length);
    $('nHigh').textContent = String(events.filter(isHigh).length);
    $('nFlag').textContent = String(events.filter((e) => e.flags.length).length);
    $('nChg').textContent = String(changed.size);
    for (const e of events) {
      if (show === 'high' && !isHigh(e)) continue;
      if (show === 'flagged' && !e.flags.length) continue;
      if (show === 'changes' && !changed.has(e.n)) continue;
      const high = isHigh(e);
      // Each row = one event on the rail; red seal for high risk, amber for medium
      const li = el('li', `row ${high ? 'is-high' : e.flags.length ? 'is-med' : ''}`);
      const top = el('div', 'ev-top');
      top.append(el('span', 'font-mono text-xs text-muted', `#${e.n}`), el('span', 'font-mono text-sm font-semibold', e.timeText),
        el('span', 'font-semibold', e.user || '-'), el('span', 'text-sm text-muted', e.role), el('span', 'font-mono text-sm', e.ip),
        el('span', 'font-mono text-sm font-semibold', e.action));
      li.append(top, el('p', 'font-mono text-xs text-ink/70 break-all mt-0.5', `${e.target} ${e.detail}`));
      // High-risk flags always in view; with 3+ flags, the first medium one shows and the rest fold behind "+N more"
      const order = [...e.flags.filter((f) => f.severity === 'high'), ...e.flags.filter((f) => f.severity !== 'high')];
      const inView = order.length > 2 ? order.filter((f, i) => f.severity === 'high' || i === order.findIndex((g) => g.severity !== 'high')) : order;
      const folded = order.filter((f) => !inView.includes(f));
      const fold = folded.length ? el('details', 'more mt-1') : null;
      if (fold) fold.append(el('summary', '', `+${folded.length} more flag${folded.length === 1 ? '' : 's'}: ${folded.map((f) => f.code).join(', ')}`));
      for (const f of order) {
        const p = el('p', `mt-1 text-sm ${f.severity === 'high' ? 'text-flag font-semibold' : 'text-ink'}`, f.reason);
        p.prepend(el('span', 'pill-ico', f.severity === 'high' ? '▲ ' : '● '));
        p.firstElementChild!.setAttribute('aria-hidden', 'true');
        // MITRE ATT&CK chip(s): standard name for the technique this flag points to
        for (const t of MITRE[f.code] ?? []) {
          const a = el('a', 'mitre-chip', t.id) as HTMLAnchorElement;
          a.href = mitreUrl(t.id); a.target = '_blank'; a.rel = 'noopener'; a.title = `MITRE ATT&CK ${t.id}: ${t.name}`;
          p.append(' ', a);
        }
        (fold && folded.includes(f) ? fold : li).append(p);
      }
      if (fold) li.append(fold);
      list.append(li);
    }
    if (parsed.unparsed.length) {
      const d = el('details', 'mt-3 text-xs');
      d.append(el('summary', 'cursor-pointer text-muted', `${parsed.unparsed.length} lines not understood (kept, not dropped)`));
      parsed.unparsed.slice(0, 50).forEach((u) => d.append(el('pre', 'font-mono whitespace-pre-wrap', u)));
      list.append(d);
    }
    $('result').classList.remove('hidden');
    setIntake(false);
    await audit('TIMELINE_BUILT', `${events.length} events · ${v.high} high · ${v.medium} medium · ${parsed.unparsed.length} not understood`);
    showLocker();
    // On phones the result is below the input: bring it into view after a new case
    if (scrollToResult && window.innerWidth < 1024) $('result').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  }
</script>
