---
// Shared page shell: title, meta description, fonts, footer
import '../styles/global.css';
import QRCode from 'qrcode';

// QR code of the live URL, made at build time (no extra script in the browser)
const LIVE_URL = 'https://loglens-v2.loglens.workers.dev';
const FONTS_URL = 'https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;600;700&family=IBM+Plex+Sans+Condensed:wght@600;700&family=Noto+Sans+Devanagari:wght@400;600&display=swap';
const qrSvg = await QRCode.toString(LIVE_URL, { type: 'svg', margin: 1, color: { dark: '#14161A', light: '#F4F1EA' } });
const { title = 'LogLens', description = 'AI-assisted digital forensics: log timeline, AI summary and SHA-256 evidence check.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={LIVE_URL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fonts load without blocking the first paint: system font shows first, then swaps -->
    <link rel="preload" as="style" href={FONTS_URL} onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href={FONTS_URL} /></noscript>
  </head>
  <body class="font-sans min-h-screen flex flex-col">
    <main class="flex-1 w-full max-w-6xl mx-auto px-4 py-6 lg:py-10">
      <slot />
    </main>
    <footer class="border-t border-line text-sm text-muted px-4 py-6">
      <div class="max-w-6xl mx-auto flex items-center gap-4">
        <div class="w-24 h-24 shrink-0" set:html={qrSvg} aria-label={`QR code for ${LIVE_URL}`} role="img"></div>
        <div>
          <p>Try it on your phone: <a class="underline" href={LIVE_URL}>{LIVE_URL.replace('https://', '')}</a></p>
          <p>Built by team SOLAR FLARES (HK26-0014) for अvinya '26 Hackathon 4.0, BIET Lucknow. v1 was first built at CHAKRAVYUH 1.0; this is the upgraded v2.</p>
          <p>AI summaries come from Google Gemini and can be wrong. All sample cases are made-up data.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
