---
// Shared page shell: title, meta description, fonts, footer
import '../styles/global.css';
import QRCode from 'qrcode';

// QR code of the live URL, made at build time (no extra script in the browser)
const LIVE_URL = 'https://loglens-v2.loglens.workers.dev';
const FONTS_URL = 'https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;600;700&family=IBM+Plex+Sans+Condensed:wght@600;700&family=Noto+Sans+Devanagari:wght@400;600&display=swap';
const qrSvg = await QRCode.toString(LIVE_URL, { type: 'svg', margin: 1, color: { dark: '#14161A', light: '#F4F1EA' } });
const { title = 'LogLens', current = 'desk', description = 'AI-assisted digital forensics: log timeline, AI summary and SHA-256 evidence check.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={LIVE_URL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fonts load without blocking the first paint: system font shows first, then swaps -->
    <link rel="preload" as="style" href={FONTS_URL} onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href={FONTS_URL} /></noscript>
  </head>
  <body class="font-sans min-h-screen flex flex-col">
    <!-- App bar: frosted, sticky, the same on every page; Desk | Cases is a segmented control -->
    <header class="appbar">
      <div class="max-w-6xl mx-auto px-4 flex items-center gap-3 min-h-14">
        <a href="/" class="flex items-center gap-2 font-cond font-bold text-xl tracking-wide no-underline">
          <!-- Logo: a magnifier with an eye that blinks every 5 s (still under prefers-reduced-motion) -->
          <picture>
            <source media="(prefers-reduced-motion: reduce)" srcset="/brand/loglens-mark-dark-still.svg" />
            <img src="/brand/loglens-mark-dark.svg" alt="" width="38" height="38" class="w-[38px] h-[38px]" />
          </picture>
          LogLens
        </a>
        <span class="hidden sm:inline text-sm text-[#9AA3AB] border-l border-white/20 pl-3">AI-assisted digital forensics console</span>
        <nav class="segnav ml-auto" aria-label="Main">
          <a href="/" class="navlink" aria-current={current === 'desk' ? 'page' : undefined}>Desk</a>
          <a href="/cases" class="navlink" aria-current={current === 'cases' ? 'page' : undefined}>Cases</a>
        </nav>
      </div>
    </header>
    <main class="flex-1 w-full max-w-6xl mx-auto px-4 py-5 lg:py-7">
      <slot />
    </main>
    <footer class="bg-night text-[#B9C0C7] text-sm px-4 py-8 mt-8">
      <div class="max-w-6xl mx-auto grid gap-6 md:grid-cols-[auto_1fr] items-start">
        <div class="flex items-center gap-4">
          <div class="w-24 h-24 shrink-0 rounded-lg overflow-hidden" set:html={qrSvg} aria-label={`QR code for ${LIVE_URL}`} role="img"></div>
          <p class="max-w-[14rem]">Scan to open on your phone: <a class="underline text-white" href={LIVE_URL}>{LIVE_URL.replace('https://', '')}</a></p>
        </div>
        <div class="space-y-1.5 max-w-3xl">
          <p><span class="text-white font-semibold">LogLens</span> by team SOLAR FLARES (HK26-0014) for अvinya '26 Hackathon 4.0, BIET Lucknow. v1 was first built at CHAKRAVYUH 1.0; this is the upgraded v2.</p>
          <p>AI: open-weight Llama 3.1 8B (Meta, Llama licence) on Cloudflare Workers AI, with Google Gemini as a backup. AI summaries can be wrong. Three sample cases are made-up data; "Real SSH server log" is real public research data from Loghub (github.com/logpai/loghub).</p>
        </div>
      </div>
    </footer>
  </body>
</html>
