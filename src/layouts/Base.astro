---
// Shared page shell: title, meta description, fonts, footer
import '../styles/global.css';
import QRCode from 'qrcode';

// QR code of the live URL, made at build time (no extra script in the browser)
const LIVE_URL = 'https://loglens-v2.loglens.workers.dev';
const FONTS_URL = 'https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;600;700&family=IBM+Plex+Sans+Condensed:wght@600;700&family=Noto+Sans+Devanagari:wght@400;600&display=swap';
const qrSvg = await QRCode.toString(LIVE_URL, { type: 'svg', margin: 1, color: { dark: '#14161A', light: '#F4F1EA' } });
const { title = 'LogLens', current = 'desk', description = 'AI-assisted digital forensics: log timeline, AI summary and SHA-256 evidence check.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={LIVE_URL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fonts load without blocking the first paint: system font shows first, then swaps -->
    <link rel="preload" as="style" href={FONTS_URL} onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href={FONTS_URL} /></noscript>
  </head>
  <body class="font-sans min-h-screen flex flex-col">
    <!-- App bar: frosted, sticky, the same on every page; Desk | Cases is a segmented control -->
    <header class="appbar">
      <div class="max-w-6xl mx-auto px-4 flex items-center gap-3 min-h-14">
        <a href="/" class="flex items-center gap-2 font-semibold no-underline">
          <svg aria-hidden="true" width="26" height="26" viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="#E3A72F"/><circle cx="14" cy="14" r="7" fill="none" stroke="#1B1F24" stroke-width="3"/><path d="M19 19l7 7" stroke="#1B1F24" stroke-width="3" stroke-linecap="round"/></svg>
          LogLens
        </a>
        <span class="hidden sm:inline text-muted text-sm">digital forensics desk</span>
        <nav class="segnav ml-auto" aria-label="Main">
          <a href="/" class="navlink" aria-current={current === 'desk' ? 'page' : undefined}>Desk</a>
          <a href="/cases" class="navlink" aria-current={current === 'cases' ? 'page' : undefined}>Cases</a>
        </nav>
      </div>
    </header>
    <main class="flex-1 w-full max-w-6xl mx-auto px-4 py-6 lg:py-8">
      <slot />
    </main>
    <footer class="border-t border-line text-sm text-muted px-4 py-6">
      <div class="max-w-6xl mx-auto flex items-center gap-4">
        <div class="w-24 h-24 shrink-0" set:html={qrSvg} aria-label={`QR code for ${LIVE_URL}`} role="img"></div>
        <div>
          <p>Try it on your phone: <a class="underline" href={LIVE_URL}>{LIVE_URL.replace('https://', '')}</a></p>
          <p>Built by team SOLAR FLARES (HK26-0014) for अvinya '26 Hackathon 4.0, BIET Lucknow. v1 was first built at CHAKRAVYUH 1.0; this is the upgraded v2.</p>
          <p>AI summaries come from Google Gemini and can be wrong. All sample cases are made-up data.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
