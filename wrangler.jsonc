// v2: Cloudflare Worker with static assets (Astro build in dist/) + /api routes in worker/index.ts.
// Separate name from v1 (Pages project loglens-solarflares), so v1's URL is never touched.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loglens-v2",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true, // every request goes through the Worker, so security headers are added to pages too
    "not_found_handling": "404-page"
  },
  // Server-side evidence ledger (D1 = SQLite), schema in schema/audit.sql
  "d1_databases": [
    { "binding": "DB", "database_name": "loglens-audit", "database_id": "b8f8e4ca-0422-4455-8814-1e4bc9a672ab" }
  ],
  // Cloudflare Workers AI (second AI provider, runs next to Gemini)
  "ai": { "binding": "AI" },
  // 20 AI calls per IP per minute (period must be 10 or 60 seconds)
  "ratelimits": [
    { "name": "AI_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ]
}
